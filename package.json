{
  "name": "desktop-remote",
  "version": "1.0.0",
  "description": "Interactive TUI and local runtime supervisor for Desktop Commander Remote",
  "bin": {
    "desktop-remote": "./bin/desktop-remote.js"
  },
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run bin/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "test:build:prod": "bun test ./test/build/production-artifact.gate.ts",
    "daemon:dev": "bun run bin/daemon.ts",
    "attach:dev": "bun run bin/attach.ts",
    "build:prod": "bun run scripts/build-production.ts",
    "test:soak": "bun run scripts/soak.ts",
    "test:soak:real": "bun run scripts/soak-real.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@opentui/core": "0.5.3",
    "@opentui/solid": "0.5.3",
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "cli-highlight": "^2.1.11",
    "commander": "^15.0.0",
    "docx": "9.7.1",
    "exceljs": "4.4.0",
    "pdf-lib": "1.17.1",
    "solid-js": "1.9.12",
    "tsx": "^4.19.0",
    "zod": "^4.4.3"
  }
}
